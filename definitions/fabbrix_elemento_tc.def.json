    "overrides": {
		"machine_name":                    { "default_value": "Fabbrix Elemento TC" },
		"machine_gcode_flavor":            { "default_value": "RepRap (RepRap)" },
        "machine_start_gcode":             { "default_value": "M190 S{material_bed_temperature}\n G32\n G29 S1 P\"scan_leveling.csv\"\n G1 Z55 F1000\n G21 ;metric values\n G90 ;absolute positioning\n M83 ;set extruder to absolute mode\n M107 ;start with the fan off\n G92 E0 ;zero the extruded length\n {if (extruders_enabled_count == 2)}\nM109 T0 S{material_print_temperature_layer_0, 0}\n M109 T1 S{material_print_temperature_layer_0, 1}\nM572 D0 S{material_pressure_advance_factor, 0}\n M572 D1 S{material_pressure_advance_factor, 1}\n{else}\nM109 T{initial_extruder_nr} S{material_print_temperature_layer_0, initial_extruder_nr}\n M572 D{initial_extruder_nr} S{material_pressure_advance_factor, initial_extruder_nr}\n{endif}\nG92 E0 ; reset extruder\n T{initial_extruder_nr}\n M98 P\"0:/macros/Calibration/inputshaping.g\"\n G92 E0.0 ; reset extruder\n G1 Z3 F400\n G1 X550 Y-2 Z1 F3000.0 ; position 10mm down from the lower left of the first layer\n G1 X650 Y-2 E20 F1000.0 ; extrude 20mm of filament in the x direction\n G92 E0.0 ; reset extruder\n G1 Z4 F400 ; small retraction\n M117 Printing...\n " },
        "machine_end_gcode":               { "default_value": "T-1 \nG1 Z620 \nG90 ;Absolute positionning \nM106 S0 ;Turn-off fan \nM106 P2 S0 ;Turn-off fan \nG10 P0 S0 R0 ;Turn-off hotend \nG10 P1 S0 R0 ;Turn-off hotend \nM140 S0 ;Turn-off bed \nM84 X Y E ;Disable all steppers but Z \nM98 P\"endPrint.g\"" },
        "machine_extruder_count":          { "default_value": 2 },
        "machine_heated_bed":              { "default_value": true },
        "machine_heated_build_volume":     { "default_value": true },
        "machine_width":                   { "default_value": 1100 },
        "machine_height":                  { "default_value": 620 },
        "machine_depth":                   { "default_value": 605 },
        "machine_center_is_zero":          { "default_value": false},
        "machine_max_feedrate_x": { "value": 300 },
        "machine_max_feedrate_y": { "value": 300 },
        "machine_max_feedrate_z": { "value": 50 },
        "machine_max_feedrate_e": { "value":  250},
        "machine_max_acceleration_x": { "value": 2000 },
        "machine_max_acceleration_y": { "value": 2000 },
        "machine_max_acceleration_z": { "value": 600 },
        "machine_max_acceleration_e": { "value": 500 },
        "machine_acceleration": { "value": 10000 },
        "machine_max_jerk_xy": { "value": 10 },
        "machine_max_jerk_z": { "value": 5 },
        "machine_max_jerk_e": { "value": 15 },
        "material_diameter": { "default_value": 2.85 },
        "acceleration_print": { "value": 10000 },
        "acceleration_travel": { "value": 14000 },
        "acceleration_travel_layer_0": { "value": "acceleration_travel" },
        "jerk_travel": { "value": "jerk_print" },
        "jerk_travel_layer_0": { "value": "jerk_travel" },
        "machine_start_gcode_first" : {"value":true},
        "relative_extrusion": {"value":true},
        "support_z_distance": { "value": "layer_height" },
        "acceleration_enabled" : {"value":true},
        "jerk_enabled" : {"value":true},
        "prime_tower_position_x" : {"value":550},
